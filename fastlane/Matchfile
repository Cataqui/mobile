require "base64"

ENV["MATCH_PASSWORD"] = ENV.fetch("APPLE_SIGNING_ENCRYPTION_PASSWORD")
ENV["MATCH_GIT_BASIC_AUTHORIZATION"] = Base64.strict_encode64(
  "x-access-token:#{ENV.fetch("APPLE_SIGNING_REPOSITORY_AUTH")}"
)

git_url(ENV.fetch("APPLE_SIGNING_GITHUB_REPOSITORY_URL"))
git_branch("main")
storage_mode("git")
type("appstore")
app_identifier(["com.cataqui.mobile"])
readonly(true)
