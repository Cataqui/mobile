# Copy this file to .env and replace values for your local setup.
ENVIRONMENT=development

# Optional: required only for local release Android App Bundle signing.
AAB_SIGNING_KEYSTORE_BASE64=replace-with-base64-keystore
AAB_SIGNING_KEYSTORE_PASSWORD=replace-with-keystore-password
AAB_SIGNING_KEY_ALIAS=replace-with-key-alias
AAB_SIGNING_KEY_PASSWORD=replace-with-key-password

# Optional: required only for local Fastlane signing and release work.
APPLE_DEVELOPER_TEAM_ID=replace-with-apple-developer-team-id
APPLE_SIGNING_GITHUB_REPOSITORY_URL=https://github.com/Cataqui/apple-signing.git
APPLE_SIGNING_ENCRYPTION_PASSWORD=replace-with-encryption-password
APPLE_SIGNING_REPOSITORY_AUTH=replace-with-read-and-write-github-pat
APP_STORE_CONNECT_API_KEY_ID=replace-with-key-id
APP_STORE_CONNECT_ISSUER_ID=replace-with-issuer-id
APP_STORE_CONNECT_API_KEY_BASE64=replace-with-base64-private-key
