{
  "version": 8,
  "id": "qui-light",
  "name": "Qui Light",
  "metadata": {
    "mapbox:autocomposite": false,
    "mapbox:type": "template",
    "qui:style": "light"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["{tileUrlTemplate}"],
      "minzoom": 1,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ebedef"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#d7d9db",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#d7d9db",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d7d9db",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#dadbdc",
        "fill-opacity": 1
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#dadbdc",
        "line-width": {
          "stops": [
            [10, 0.7],
            [16, 2.2]
          ]
        },
        "line-opacity": 0.9
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e8e8e8",
        "fill-outline-color": "#d9d9d9",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#b3b3b3",
        "line-width": 0.7,
        "line-opacity": 0.65
      }
    },
    {
      "id": "tunnel",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "brunnel", "tunnel"],
      "paint": {
        "line-color": "#dedede",
        "line-width": {
          "stops": [
            [10, 0.3],
            [14, 2],
            [16, 6]
          ]
        },
        "line-opacity": 0.45
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "minor"],
        ["==", "class", "service"],
        ["==", "class", "track"],
        ["==", "class", "path"]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [11, 0.15],
            [14, 0.45],
            [16, 1.4]
          ]
        },
        "line-opacity": 0.95
      }
    },
    {
      "id": "road_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "tertiary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [8, 0.25],
            [12, 0.9],
            [14, 2.4],
            [16, 5.2]
          ]
        },
        "line-opacity": 0.82
      }
    },
    {
      "id": "road_secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [8, 0.35],
            [12, 1.2],
            [14, 3.3],
            [16, 7]
          ]
        },
        "line-opacity": 0.86
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [8, 0.45],
            [12, 1.7],
            [14, 4.5],
            [16, 9]
          ]
        },
        "line-opacity": 0.9
      }
    },
    {
      "id": "road_trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [7, 0.55],
            [12, 2.2],
            [14, 5.8],
            [16, 11.5]
          ]
        },
        "line-opacity": 0.92
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [5, 0.6],
            [10, 1.5],
            [14, 6],
            [16, 13.5]
          ]
        },
        "line-opacity": 0.95
      }
    },
    {
      "id": "bridge",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "brunnel", "bridge"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [10, 0.5],
            [14, 3],
            [16, 12]
          ]
        },
        "line-opacity": 0.9
      }
    },
    {
      "id": "place_state_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "maxzoom": 9,
      "filter": ["==", "class", "state"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": {
          "stops": [
            [3, 7],
            [4, 9],
            [5, 12],
            [8, 18]
          ]
        },
        "text-max-width": 5,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#7b7c7d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1,
        "text-opacity": 0.5
      }
    },
    {
      "id": "place_megacity_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "maxzoom": 11,
      "filter": [">=", "capital", 2],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": {
          "stops": [
            [4, 7],
            [5, 11],
            [8, 15.5],
            [10, 18],
            [11, 22]
          ]
        },
        "text-max-width": 14,
        "text-anchor": "bottom"
      },
      "paint": {
        "text-color": "#555657",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place_city_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "maxzoom": 11,
      "filter": ["any", ["==", "class", "city"], ["<=", "rank", 4]],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": {
          "stops": [
            [5, 10],
            [8, 14],
            [10, 18],
            [11, 20]
          ]
        },
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#555657",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place_town_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["==", "class", "town"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": {
          "stops": [
            [8, 11],
            [10, 13],
            [14, 18]
          ]
        },
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#b3b4b5",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place_region_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "any",
        ["==", "class", "suburb"],
        ["==", "class", "neighbourhood"],
        ["==", "class", "neighborhood"],
        ["==", "class", "quarter"],
        ["==", "class", "hamlet"],
        ["==", "class", "village"]
      ],
      "minzoom": 11,
      "maxzoom": 16,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": {
          "stops": [
            [11, 11],
            [12, 13],
            [14, 15]
          ]
        },
        "text-max-width": 11
      },
      "paint": {
        "text-color": "#68696a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road_major_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "maxzoom": 18,
      "filter": [
        "any",
        ["==", "class", "motorway"],
        ["==", "class", "trunk"],
        ["==", "class", "primary"],
        ["==", "class", "secondary"],
        ["==", "class", "tertiary"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": {
          "stops": [
            [13, 8],
            [14, 10],
            [16, 12]
          ]
        }
      },
      "paint": {
        "text-color": "#7b7c7d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road_local_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": [
        "any",
        ["==", "class", "minor"],
        ["==", "class", "service"],
        ["==", "class", "track"],
        ["==", "class", "path"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": {
          "stops": [
            [15, 8],
            [18, 11]
          ]
        }
      },
      "paint": {
        "text-color": "#9c9d9e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Inter"],
        "text-size": 13,
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#9c9d9e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
